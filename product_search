<!DOCTYPE html>
<html lang="ko">



<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SIWOOM K - 품목검색</title>
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;700&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #f5f4f0;
      --surface: #ffffff;
      --border: #e8e6e0;
      --text-primary: #1a1a1a;
      --text-secondary: #888880;
      --text-muted: #b8b6b0;
      --accent-blue: #5b9bd5;
      --sidebar-w: 56px;
      --topbar-h: 52px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Noto Sans KR', sans-serif;
      background: var(--bg);
      color: var(--text-primary);
      height: 100vh;
      display: flex;
      overflow: hidden;
    }

    /* ── 사이드바 (기존 유지) ── */
    .sidebar {
      width: var(--sidebar-w);
      background: var(--surface);
      border-right: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 14px 0;
      flex-shrink: 0;
    }
    .nav-icon {
      width: 36px;
      height: 36px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 4px;
      color: var(--text-muted);
      cursor: pointer;
    }
    .nav-icon.active { background: var(--text-primary); color: white; }

    /* ── 메인 영역 ── */
    .main { flex: 1; display: flex; flex-direction: column; overflow: hidden; }

    /* ── 탑바 ── */
    .topbar {
      height: var(--topbar-h);
      background: var(--surface);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      padding: 0 20px;
      justify-content: space-between;
    }
    .topbar-left { display: flex; align-items: center; gap: 15px; font-size: 14px; font-weight: 500; }
    .search-bar {
      background: var(--bg);
      border-radius: 6px;
      padding: 5px 12px;
      width: 300px;
      display: flex;
      align-items: center;
      border: 1px solid var(--border);
    }
    .search-bar input { border: none; background: none; outline: none; width: 100%; font-size: 12px; }

    /* ── 콘텐츠 레이아웃 ── */
    .content-layout {
      display: grid;
      grid-template-columns: 1fr 1fr; /* 5:5 비율 혹은 이미지에 맞춰 조정 */
      height: calc(100vh - var(--topbar-h));
      overflow: hidden;
    }

    /* 섹션 공통 */
    .section {
      padding: 15px;
      display: flex;
      flex-direction: column;
      gap: 15px;
      overflow-y: auto;
      border-right: 1px solid var(--border);
    }
    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--border);
      font-size: 13px;
      font-weight: 600;
    }

    /* 카드 스타일 (필터, 상세) */
    .white-box {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 20px;
    }

    /* 폼 요소 */
    .form-group { margin-bottom: 15px; }
    .form-group label { display: block; font-size: 11px; color: var(--text-secondary); margin-bottom: 5px; }
    .form-select, .form-input {
      width: 100%;
      padding: 8px;
      border: 1px solid var(--border);
      border-radius: 4px;
      font-size: 12px;
      outline: none;
    }
    .btn-blue {
      width: 100%;
      padding: 10px;
      background: var(--accent-blue);
      color: white;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      font-weight: 500;
    }

    /* ── 품목 리스트 (우측) ── */
    .item-list-container { padding: 0; background: var(--surface); }
    .list-item {
      display: flex;
      padding: 15px;
      border-bottom: 1px solid var(--border);
      gap: 15px;
      align-items: center;
    }
    .item-thumb { width: 40px; height: 40px; background: #eee; border-radius: 4px; overflow: hidden; }
    .item-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .item-info { flex: 1; }
    .item-title { font-size: 12px; font-weight: 500; margin-bottom: 4px; }
    .item-meta { font-size: 11px; color: var(--text-muted); }

    /* 상세 페이지 내 아이콘 버튼 영역 */
    .detail-actions { display: flex; gap: 20px; margin-bottom: 20px; justify-content: center; }
    .action-item { text-align: center; cursor: pointer; }
    .action-icon {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: var(--accent-blue);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 5px;
    }
    .action-item span { font-size: 11px; color: var(--text-secondary); }

  </style>
</head>
<body>
<!-- 상단 브랜드 로고 클릭 시 홈으로 이동 -->
<span class="topbar-brand" onclick="window.location.href='index.html'" style="cursor:pointer;">SIWOOM K</span>

<!-- 사이드바 홈 아이콘 클릭 시 홈으로 이동 -->
<div class="nav-icon" onclick="window.location.href='index.html'">🏠</div>

<div class="sidebar">
  <div class="nav-icon active">🔍</div>
  <div class="nav-icon">📅</div>
  <div class="nav-icon">📦</div>
  <div class="nav-icon">🛒</div>
</div>

<div class="main">
  <div class="topbar">
    <div class="topbar-left">
      <span>SIWOOM K</span>
      <span style="color:var(--text-muted)">|</span>
      <span>품목검색</span>
    </div>
    <div class="search-bar">
      <input type="text" placeholder="Search 품목검색">
    </div>
    <div></div>
  </div>

  <div class="content-layout">
    <!-- 왼쪽: 필터 및 상세 -->
    <div class="section">
      <!-- Filter -->
      <div class="section-header">
