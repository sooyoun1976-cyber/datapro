        </div>

        <div class="form-group">
          <label>포장박스번호</label>
          <input type="text" class="form-input">
        </div>

        <button class="btn-blue">POSSIBLE</button>
      </div>
    </div>

    <!-- 오른쪽: 품목 리스트 -->
    <div class="section item-list-container">
      <div class="section-header" style="padding: 15px;">
        <span>품목 FILTER</span>
        <button style="border:1px solid var(--accent-blue); background:none; color:var(--accent-blue); padding:4px 10px; border-radius:3px; font-size:11px;">목록다운로드</button>
      </div>

      <!-- 리스트 아이템 반복 -->
      <div class="list-item">
        <div class="item-thumb"></div>
        <div class="item-info">
          <div class="item-title">TXT - [ 2026 시즌그리팅 ]</div>
        </div>
        <div class="item-meta">0</div>
      </div>

      <div class="list-item">
        <div class="item-info">
          <div class="item-title">TXT - [ 2026 시즌그리팅 ] / 위버스</div>
        </div>
      </div>

      <div class="list-item">
        <div class="item-info">
          <div class="item-title">TXT - [ 2026 시즌그리팅 ] / 카카오</div>
        </div>
      </div>

      <div class="list-item">
        <div class="item-thumb"></div>
        <div class="item-info">
          <div class="item-title">TXT - [ 2026 시즌그리팅 ] / PPULBATU 2026 달력</div>
          <div class="item-meta">PPULBATU 2026 달력</div>
        </div>
        <div class="item-meta">0</div>
      </div>
      
      <!-- 필요한 만큼 추가 -->
    </div>
  </div>
</div>

<script>
  // 간단한 인터랙션 추가 가능 영역
</script>

</body>
</html>
